{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "name": "Visual Designer Follower Growth System",
    "version": "1.0.0",
    "description": "W3C Design Tokens for 2D/3D/Print visual designer brand — optimized for maximum social media impact and follower conversion.",
    "author": "Visual Designer System"
  },

  "color": {
    "$type": "color",
    "base": {
      "black":       { "$value": "#0A0A0F", "$description": "Deep void black — primary background" },
      "purple":      { "$value": "#7B2FFF", "$description": "Electric purple — primary brand accent" },
      "purple-dark": { "$value": "#4B1FA0", "$description": "Deep purple — hover/shadow states" },
      "cyan":        { "$value": "#00F5FF", "$description": "Neon cyan — secondary accent / glow" },
      "cyan-dark":   { "$value": "#00AACC", "$description": "Deep cyan — muted accent" },
      "gold":        { "$value": "#FFD700", "$description": "Premium gold — premium/CTA highlights" },
      "gold-dark":   { "$value": "#B8960C", "$description": "Dark gold — shadows/depth" },
      "white":       { "$value": "#FFFFFF", "$description": "Pure white — primary text" },
      "grey-100":    { "$value": "#F5F5F5", "$description": "Near white — secondary text" },
      "grey-400":    { "$value": "#9A9A9A", "$description": "Mid grey — captions/metadata" },
      "grey-800":    { "$value": "#1A1A24", "$description": "Dark panel — card/surface backgrounds" },
      "grey-900":    { "$value": "#12121A", "$description": "Near-black panel — elevated surfaces" }
    },

    "semantic": {
      "background":       { "$value": "{color.base.black}" },
      "surface":          { "$value": "{color.base.grey-800}" },
      "surface-raised":   { "$value": "{color.base.grey-900}" },
      "text-primary":     { "$value": "{color.base.white}" },
      "text-secondary":   { "$value": "{color.base.grey-100}" },
      "text-muted":       { "$value": "{color.base.grey-400}" },
      "brand-primary":    { "$value": "{color.base.purple}" },
      "brand-secondary":  { "$value": "{color.base.cyan}" },
      "brand-premium":    { "$value": "{color.base.gold}" },
      "glow-purple":      { "$value": "{color.base.purple}" },
      "glow-cyan":        { "$value": "{color.base.cyan}" }
    },

    "gradient": {
      "hero":    { "$value": "linear-gradient(135deg, #7B2FFF 0%, #00F5FF 100%)", "$description": "Primary hero gradient" },
      "dark":    { "$value": "linear-gradient(180deg, #0A0A0F 0%, #1A1A24 100%)", "$description": "Dark background gradient" },
      "gold":    { "$value": "linear-gradient(90deg, #B8960C 0%, #FFD700 50%, #B8960C 100%)", "$description": "Premium gold shimmer" },
      "glow":    { "$value": "radial-gradient(ellipse at center, rgba(123,47,255,0.4) 0%, transparent 70%)", "$description": "Purple glow effect" },
      "cyan-glow": { "$value": "radial-gradient(ellipse at center, rgba(0,245,255,0.3) 0%, transparent 70%)", "$description": "Cyan glow effect" }
    }
  },

  "typography": {
    "$type": "typography",
    "fontFamily": {
      "display":  { "$value": "'Inter', 'Space Grotesk', sans-serif", "$description": "Headlines and hero text" },
      "body":     { "$value": "'Inter', 'DM Sans', sans-serif", "$description": "Body copy and UI text" },
      "mono":     { "$value": "'JetBrains Mono', 'Fira Code', monospace", "$description": "Code, tags, metadata" },
      "accent":   { "$value": "'Space Grotesk', 'Bebas Neue', sans-serif", "$description": "Badges, skills labels" }
    },

    "fontSize": {
      "xs":   { "$value": "11px" },
      "sm":   { "$value": "13px" },
      "base": { "$value": "16px" },
      "md":   { "$value": "20px" },
      "lg":   { "$value": "28px" },
      "xl":   { "$value": "36px" },
      "2xl":  { "$value": "48px" },
      "3xl":  { "$value": "64px" },
      "4xl":  { "$value": "80px" },
      "5xl":  { "$value": "112px" },
      "hero": { "$value": "144px" }
    },

    "fontWeight": {
      "thin":       { "$value": "100" },
      "light":      { "$value": "300" },
      "regular":    { "$value": "400" },
      "medium":     { "$value": "500" },
      "semibold":   { "$value": "600" },
      "bold":       { "$value": "700" },
      "extrabold":  { "$value": "800" },
      "black":      { "$value": "900" }
    },

    "lineHeight": {
      "tight":   { "$value": "1.0" },
      "snug":    { "$value": "1.2" },
      "normal":  { "$value": "1.5" },
      "relaxed": { "$value": "1.75" }
    },

    "letterSpacing": {
      "tight":   { "$value": "-0.04em" },
      "normal":  { "$value": "0em" },
      "wide":    { "$value": "0.05em" },
      "wider":   { "$value": "0.1em" },
      "widest":  { "$value": "0.2em" },
      "ultra":   { "$value": "0.4em" }
    }
  },

  "spacing": {
    "$type": "number",
    "0":   { "$value": "0px" },
    "1":   { "$value": "4px" },
    "2":   { "$value": "8px" },
    "3":   { "$value": "12px" },
    "4":   { "$value": "16px" },
    "5":   { "$value": "20px" },
    "6":   { "$value": "24px" },
    "8":   { "$value": "32px" },
    "10":  { "$value": "40px" },
    "12":  { "$value": "48px" },
    "16":  { "$value": "64px" },
    "20":  { "$value": "80px" },
    "24":  { "$value": "96px" },
    "32":  { "$value": "128px" }
  },

  "borderRadius": {
    "none":  { "$value": "0px" },
    "sm":    { "$value": "4px" },
    "base":  { "$value": "8px" },
    "md":    { "$value": "12px" },
    "lg":    { "$value": "16px" },
    "xl":    { "$value": "24px" },
    "full":  { "$value": "9999px" }
  },

  "shadow": {
    "purple-glow-sm":  { "$value": "0 0 20px rgba(123, 47, 255, 0.5)", "$description": "Small purple glow" },
    "purple-glow-lg":  { "$value": "0 0 60px rgba(123, 47, 255, 0.4), 0 0 120px rgba(123, 47, 255, 0.2)", "$description": "Large purple ambient glow" },
    "cyan-glow-sm":    { "$value": "0 0 20px rgba(0, 245, 255, 0.5)", "$description": "Small cyan glow" },
    "cyan-glow-lg":    { "$value": "0 0 60px rgba(0, 245, 255, 0.4), 0 0 120px rgba(0, 245, 255, 0.15)", "$description": "Large cyan ambient glow" },
    "gold-glow":       { "$value": "0 0 30px rgba(255, 215, 0, 0.4)", "$description": "Gold premium glow" },
    "card":            { "$value": "0 8px 32px rgba(0, 0, 0, 0.6)", "$description": "Card elevation shadow" }
  },

  "motion": {
    "duration": {
      "fast":    { "$value": "150ms" },
      "base":    { "$value": "250ms" },
      "slow":    { "$value": "400ms" },
      "slower":  { "$value": "600ms" }
    },
    "easing": {
      "default":   { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
      "spring":    { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)" },
      "sharp":     { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    }
  },

  "platform": {
    "instagram-post":   { "$value": "1080x1080", "$description": "Square Instagram post (px)" },
    "instagram-story":  { "$value": "1080x1920", "$description": "Vertical story format (px)" },
    "youtube-banner":   { "$value": "2560x1440", "$description": "YouTube channel art (px)" },
    "youtube-thumb":    { "$value": "1280x720", "$description": "YouTube thumbnail (px)" },
    "twitter-post":     { "$value": "1200x675", "$description": "Twitter/X post image (px)" },
    "pinterest-pin":    { "$value": "1000x1500", "$description": "Pinterest vertical pin (px)" },
    "poster-a3":        { "$value": "3508x4961", "$description": "A3 poster at 300dpi (px)" },
    "business-card":    { "$value": "1050x600", "$description": "Standard business card at 300dpi (px)" }
  }
}
